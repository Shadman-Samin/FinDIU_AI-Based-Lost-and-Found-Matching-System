# Copy to .env for development and populate locally. Never commit real credentials.
DATABASE_URL=
TEST_DATABASE_URL=
JWT_SECRET=
JWT_ISSUER=findiu
JWT_AUDIENCE=findiu-web
ALLOWED_ORIGINS=["http://localhost:5500"]
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=findiu-images
STORAGE_PROVIDER=supabase
UPLOAD_DIR=var/uploads
PUBLIC_BASE_URL=http://localhost:8000
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Local matching needs no Gemini key. Hybrid additionally requires per-report consent.
MATCHING_MODE=local
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMENSIONS=768
MATCH_THRESHOLD=0.75
DATE_WINDOW_DAYS=30
CONSENT_VERSION=2026-11-19-local-hybrid
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
FRONTEND_URL=http://localhost:5500
INTERNAL_TICK_TOKEN=
# Explicit seed command only:
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
